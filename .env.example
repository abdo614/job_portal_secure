# ====== إعدادات البريد ======
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=PUT_GOOGLE_APP_PASSWORD_HERE
MAIL_FROM=your_email@gmail.com

# ====== إعدادات Flask ======
FLASK_SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_VALUE
FLASK_HTTPS=0

# ====== بوت تيليجرام ======
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# ====== مفتاح التشفير (ENCRYPTION_KEY) ======
# مهم جداً للاستضافة السحابية: ضعه هنا لضمان بقاء البيانات مشفرة
# استخدم نفس القيمة عند كل عملية نشر
# مثال: ENCRYPTION_KEY=YOUR_FERNET_KEY_HERE
ENCRYPTION_KEY=

# ====== الدفع ======
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=